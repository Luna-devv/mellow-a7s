{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Command Invocations",
    "description": "Schema for Wamellow Command usage tracking events",
    "type": "object",
    "required": [
        "timestamp",
        "guild_id",
        "type",
        "name"
    ],
    "properties": {
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "guild_id": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[0-9a-f]+$"
        },
        "type": {
            "type": "string",
            "enum": ["notification"]
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
        }
    },
    "additionalProperties": false,
    "x-clickhouse-column-order": [
        "timestamp",
        "guild_id",
        "type",
        "name"
    ]
}