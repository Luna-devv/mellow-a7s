{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Command Invocations",
    "description": "Schema for Wamellow Command usage tracking events",
    "type": "object",
    "required": [
        "service_id",
        "user_id",
        "type",
        "name"
    ],
    "properties": {
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "service_id": {
            "type": "string",
            "minLength": 1
        },
        "user_id": {
            "type": "string",
            "minLength": 10,
            "maxLength": 22,
            "pattern": "^[0-9]+$"
        },
        "type": {
            "type": "string",
            "enum": [
                "command",
                "context",
                "button",
                "select",
                "modal",
                "text"
            ]
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
        }
    },
    "additionalProperties": false,
    "x-clickhouse-column-order": [
        "timestamp",
        "service_id",
        "user_id",
        "type",
        "name"
    ]
}