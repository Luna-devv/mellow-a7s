{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "TTS Invocations",
    "description": "Schema for Text to Speech API usage tracking events",
    "type": "object",
    "required": [
        "service_id",
        "language",
        "speaker"
    ],
    "properties": {
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "service_id": {
            "type": "string",
            "minLength": 1
        },
        "language": {
            "type": "string",
            "minLength": 2
        },
        "speaker": {
            "type": "string",
            "minLength": 3
        }
    },
    "additionalProperties": false,
    "x-clickhouse-column-order": [
        "timestamp",
        "service_id",
        "language",
        "speaker"
    ]
}